PORT=5000
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/nextify
# Legacy alias (still supported)
connectionString=

JWT_SECRET=your_secure_jwt_secret_here
# Access-token lifetime (default 12h). Override only with a short, intentional value.
JWT_EXPIRES_IN=12h
# Ops-only: used by `npm run provision:admin` — never used for silent runtime admin creation
ADMIN_EMAIL=admin@nextify.sa
ADMIN_PASSWORD=change_me_in_production_min_12_chars
ADMIN_USERNAME=Nextify Admin

PAYMENT_PROVIDER=moyasar
MAPS_PROVIDER=mock
BOOKING_BUFFER_MINUTES=30
# Local development. On Render set FRONTEND_URL=https://www.nextifylimo.com
FRONTEND_URL=http://localhost:5173

# Moyasar TEST/sandbox only. Never use sk_live_ / pk_live_ while MOYASAR_ENV=test.
# MOYASAR_ENV=live requires sk_live_ and pk_live_. MOYASAR_ENV=test requires sk_test_ and pk_test_.
MOYASAR_ENV=test
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=pk_test_your_publishable_key
MOYASAR_WEBHOOK_SECRET=change_me_in_moyasar_dashboard
# Allowed webhook event mode: test | live | none (defaults to MOYASAR_ENV; use none while checkout is disabled)
MOYASAR_WEBHOOK_ALLOWED_MODE=test

# WhatsApp Cloud API (do not put these in frontend env)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=nextify_whatsapp_verify
WHATSAPP_APP_SECRET=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Future integrations (optional)
GOOGLE_MAPS_API_KEY=
PAYTABS_PROFILE_ID=
PAYTABS_SERVER_KEY=
