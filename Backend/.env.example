PORT=5000
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/nextify
# Legacy alias (still supported)
connectionString=

JWT_SECRET=your_secure_jwt_secret_here
ADMIN_EMAIL=admin@nextify.sa
ADMIN_PASSWORD=change_me_in_production
ADMIN_USERNAME=Nextify Admin

PAYMENT_PROVIDER=moyasar
MAPS_PROVIDER=mock
BOOKING_BUFFER_MINUTES=30
FRONTEND_URL=http://localhost:5173

# Moyasar TEST/sandbox only. Never use sk_live_ / pk_live_ while MOYASAR_ENV=test.
MOYASAR_ENV=test
MOYASAR_PUBLISHABLE_KEY=pk_test_your_publishable_key
MOYASAR_WEBHOOK_SECRET=change_me_in_moyasar_dashboard

# Future integrations (optional)
GOOGLE_MAPS_API_KEY=
PAYTABS_PROFILE_ID=
PAYTABS_SERVER_KEY=
